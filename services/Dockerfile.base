FROM python:3.10-slim AS base
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev libffi-dev libssl-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir --retries 10 --timeout 60 -r requirements.txt
RUN pip install --no-cache-dir --retries 10 --timeout 60 fastapi uvicorn pydantic sqlalchemy redis aio_pika httpx requests python-dotenv prometheus-client opentelemetry-api opentelemetry-sdk tenacity cachetools pydantic-settings langgraph langchain-core neo4j psycopg2-binary PyJWT passlib bcrypt python-multipart twilio sendgrid python-bitcoinrpc tiktoken web3 eth-account
